{
  "components": {
    "schemas": {
      "CreateDriverRequestDto": {
        "properties": {
          "name": {
            "example": "Ana Souza",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "CreateVehicleRequestDto": {
        "properties": {
          "brand": {
            "example": "Fiat",
            "type": "string"
          },
          "color": {
            "example": "Prata",
            "type": "string"
          },
          "plate": {
            "description": "Placa no padrão antigo (ABC1234) ou Mercosul (ABC1D23). Minúsculas viram maiúsculas; espaços e hífen são removidos.",
            "example": "ABC1D23",
            "type": "string"
          }
        },
        "required": [
          "plate",
          "color",
          "brand"
        ],
        "type": "object"
      },
      "DatabaseStatus": {
        "enum": [
          "up",
          "down"
        ],
        "type": "string"
      },
      "DriverResponseDto": {
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "example": "Ana Souza",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      },
      "ErrorResponseDto": {
        "properties": {
          "error": {
            "example": "Bad Request",
            "type": "string"
          },
          "errors": {
            "description": "Lista de violações; vazia quando o erro não é de campo.",
            "items": {
              "$ref": "#/components/schemas/RuleViolationResponseDto"
            },
            "type": "array"
          },
          "message": {
            "example": "Placa inválida: use o formato ABC1234 ou ABC1D23.",
            "type": "string"
          },
          "statusCode": {
            "example": 400,
            "type": "number"
          }
        },
        "required": [
          "statusCode",
          "error",
          "message",
          "errors"
        ],
        "type": "object"
      },
      "FinishUsageRequestDto": {
        "properties": {
          "endedAt": {
            "description": "Data e hora de término com fuso, por exemplo 2026-10-25T18:00:00-03:00. Padrão: agora. Deve ser posterior ao início e não pode estar no futuro.",
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      },
      "HealthResponseDto": {
        "properties": {
          "database": {
            "allOf": [
              {
                "$ref": "#/components/schemas/DatabaseStatus"
              }
            ]
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/HealthStatus"
              }
            ]
          }
        },
        "required": [
          "status",
          "database"
        ],
        "type": "object"
      },
      "HealthStatus": {
        "enum": [
          "ok",
          "error"
        ],
        "type": "string"
      },
      "RuleViolationResponseDto": {
        "properties": {
          "field": {
            "description": "Campo ou regra que impediu a operação.",
            "example": "plate",
            "type": "string"
          },
          "message": {
            "example": "Placa inválida: use o formato ABC1234 ou ABC1D23.",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "type": "object"
      },
      "StartUsageRequestDto": {
        "properties": {
          "driverId": {
            "format": "uuid",
            "type": "string"
          },
          "reason": {
            "example": "Visita ao cliente em Campinas",
            "type": "string"
          },
          "startedAt": {
            "description": "Data e hora de início com fuso, por exemplo 2026-10-25T08:00:00-03:00. Padrão: agora. Não pode estar no futuro.",
            "format": "date-time",
            "type": "string"
          },
          "vehicleId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "vehicleId",
          "driverId",
          "reason"
        ],
        "type": "object"
      },
      "UpdateDriverRequestDto": {
        "properties": {
          "name": {
            "example": "Ana Souza",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "UpdateVehicleRequestDto": {
        "properties": {
          "brand": {
            "example": "Volkswagen",
            "type": "string"
          },
          "color": {
            "example": "Preto",
            "type": "string"
          },
          "plate": {
            "description": "Placa no padrão antigo (ABC1234) ou Mercosul (ABC1D23). Minúsculas viram maiúsculas; espaços e hífen são removidos.",
            "example": "ABC1D23",
            "type": "string"
          }
        },
        "type": "object"
      },
      "UsageResponseDto": {
        "properties": {
          "driver": {
            "$ref": "#/components/schemas/DriverResponseDto"
          },
          "endedAt": {
            "description": "Vazio enquanto a utilização está em andamento.",
            "example": null,
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "reason": {
            "example": "Visita ao cliente em Campinas",
            "type": "string"
          },
          "startedAt": {
            "example": "2026-10-25T11:00:00.000Z",
            "format": "date-time",
            "type": "string"
          },
          "vehicle": {
            "$ref": "#/components/schemas/VehicleResponseDto"
          }
        },
        "required": [
          "id",
          "startedAt",
          "endedAt",
          "reason",
          "driver",
          "vehicle"
        ],
        "type": "object"
      },
      "VehicleResponseDto": {
        "properties": {
          "brand": {
            "example": "Fiat",
            "type": "string"
          },
          "color": {
            "example": "Prata",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "plate": {
            "example": "ABC1D23",
            "type": "string"
          }
        },
        "required": [
          "id",
          "plate",
          "color",
          "brand"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "api-key": {
        "description": "Chave de API (exigida quando API_KEY está definida).",
        "in": "header",
        "name": "x-api-key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "API para controlar a utilização dos automóveis de uma empresa: cadastro de automóveis, de motoristas e registro de utilizações. Quando a variável API_KEY está definida no servidor, envie o cabeçalho x-api-key em todas as rotas, exceto /health e /docs.",
    "title": "Vehicle API",
    "version": "0.1.0"
  },
  "openapi": "3.0.0",
