                  "type": "array"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            },
            "description": "Entrada em formato inválido."
          }
        },
        "security": [
          {
            "api-key": []
          }
        ],
        "tags": [
          "drivers"
